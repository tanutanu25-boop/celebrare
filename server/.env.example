PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/celebrare
CORS_ORIGIN=http://localhost:5173

# Set to "true" to seed demo photographers (Aarav Photography & Mountain Lens Studio)
# and enable the Demo Scenario Lab without real bank transfers.
DEMO_MODE=true

# Secrets (replace with strong random values in production; never commit real secrets)
JWT_SECRET=replace_with_long_random_jwt_secret
DOWNLOAD_TOKEN_SECRET=replace_with_long_random_download_secret
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=replace_with_long_random_cloudflare_worker_secret
BANK_WEBHOOK_SECRET=replace_with_long_random_webhook_secret

# Comma-separated trusted bank alert email addresses (in addition to per-photographer allowlists)
ALLOWED_BANK_SENDERS=alerts@hdfcbank.net,upi@icicibank.com,alerts@sbi.co.in,alerts@axisbank.com
